# Compose settings. All published ports bind to loopback.
COMPOSE_PROJECT_NAME=task-scheduler
COMPOSE_PROFILES=
KAFKA_IMAGE=apache/kafka:4.1.2
REDIS_IMAGE=redis:7.4.2-alpine
POSTGRES_IMAGE=postgres:16.8-alpine
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.2.0
KAFKA_UI_PORT=8080

# A stable, non-secret KRaft cluster identifier. Keep it unchanged with existing data.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
# Host Python clients. Inside Docker use kafka:19092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=task-scheduler
KAFKA_REQUEST_TIMEOUT_MS=10000
# DLQ events include every bounded attempt error/traceback; API task size stays 900KB.
KAFKA_MAX_MESSAGE_BYTES=33554432

# Host Python clients. Inside Docker use REDIS_HOST=redis, REDIS_PORT=6379.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Supply your own local development password before running make up.
# Inside Docker use POSTGRES_HOST=postgres, POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=task_scheduler
POSTGRES_USER=task_scheduler
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# No LLM network calls in Phase 1. mock requires no API key.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048

INFRA_CHECK_TIMEOUT_SECONDS=20

# HTTP API. Host port 8002 avoids the existing local service on port 8000.
API_HOST=127.0.0.1
API_PORT=8002
API_MAX_TASK_MESSAGE_BYTES=900000
API_OUTBOX_ENABLED=true
API_OUTBOX_BATCH_SIZE=100
API_OUTBOX_POLL_SECONDS=0.5
API_OUTBOX_RETRY_SECONDS=1
API_OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
API_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=30
API_HEALTH_TIMEOUT_SECONDS=3

# Leave WORKER_ID unset when scaling; each process generates a unique ID.
WORKER_ID=
WORKER_GROUP_ID=task-workers
WORKER_CONCURRENCY=4
WORKER_TASK_TIMEOUT_SECONDS=30
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=20
WORKER_COMPLETION_TTL_SECONDS=86400
WORKER_RESULT_PUBLISH_TIMEOUT_SECONDS=30
WORKER_RETRY_POLL_SECONDS=1
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_CAP_SECONDS=300
WORKER_RETRY_ENGINE_POLL_SECONDS=0.25
WORKER_RETRY_BATCH_SIZE=100
WORKER_MAX_CRASH_CLAIMS=3
WORKER_SHUTDOWN_TIMEOUT_SECONDS=90
WORKER_REBALANCE_TIMEOUT_SECONDS=90
WORKER_MAX_POLL_INTERVAL_MS=300000
WORKER_HTTP_TIMEOUT_SECONDS=5
WORKER_HTTP_MAX_RESPONSE_BYTES=65536

# Leave SCHEDULER_ID empty for unique replica identities. Cron defaults to UTC.
SCHEDULER_ID=
SCHEDULER_HOST=127.0.0.1
SCHEDULER_PORT=8004
SCHEDULER_QUEUE_KEY=scheduled_tasks
SCHEDULER_LEADER_KEY=scheduler:leader
SCHEDULER_POLL_SECONDS=1
SCHEDULER_ELECTION_POLL_SECONDS=0.25
SCHEDULER_LEADER_TTL_SECONDS=5
SCHEDULER_RENEWAL_SECONDS=1
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MISSED_RUN_POLICY=fire_once
SCHEDULER_MISFIRE_GRACE_SECONDS=2

# Dedicated DLQ ingestion; queue status is independent of task execution status.
DLQ_HOST=127.0.0.1
DLQ_PORT=8005
DLQ_GROUP_ID=task-dlq
DLQ_BATCH_SIZE=10
DLQ_RETRY_SECONDS=1
DLQ_BULK_LIMIT=100

# AI recovery is offline by default. AGENT_KILL_SWITCH=true escalates without LLM egress.
AGENT_HOST=127.0.0.1
AGENT_PORT=8006
AGENT_ENABLED=true
AGENT_KILL_SWITCH=false
AGENT_POLL_SECONDS=0.5
AGENT_BATCH_SIZE=50
AGENT_CLUSTER_WINDOW_SECONDS=60
AGENT_CLUSTER_DEBOUNCE_SECONDS=2
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CONFIDENCE_THRESHOLD=0.85
AGENT_MAX_AUTO_REQUEUES=1
AGENT_MIN_BACKOFF_SECONDS=30
AGENT_MAX_BACKOFF_SECONDS=3600
AGENT_MAX_STEPS=4
AGENT_DIAGNOSIS_TIMEOUT_SECONDS=60
AGENT_LEASE_SECONDS=180
AGENT_LAST_ERRORS=3
AGENT_CONTEXT_MAX_BYTES=64000
AGENT_HOURLY_TOKEN_BUDGET=1000000
AGENT_HOURLY_COST_BUDGET_USD=5
AGENT_BUDGET_KEY_PREFIX=task-scheduler:agent-budget:
AGENT_PROMPT_VERSION=v1
CIRCUIT_KEY_PREFIX=task-scheduler:circuit:
CIRCUIT_COOLDOWN_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_CAP_SECONDS=5
# Override rates when selecting a model with different pricing.
LLM_INPUT_USD_PER_MILLION=3
LLM_OUTPUT_USD_PER_MILLION=15

# Optional Java 17 worker: make up JAVA=1. A distinct pending group is mandatory.
JAVA_WORKER_HOST=127.0.0.1
JAVA_WORKER_PORT=8007
JAVA_WORKER_ID=
JAVA_WORKER_GROUP_ID=task-workers-java
JAVA_WORKER_CONCURRENCY=2
JAVA_WORKER_TASK_TIMEOUT_SECONDS=30
JAVA_WORKER_VISIBILITY_TIMEOUT_SECONDS=60
JAVA_WORKER_PUBLISH_TIMEOUT_SECONDS=20
JAVA_WORKER_MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-17
JAVA_WORKER_JVM_OPTIONS=-Xms64m -Xmx256m -XX:MaxMetaspaceSize=160m -Djava.awt.headless=true
JAVA_WORKER_MAX_POLL_INTERVAL_MS=300000

# Phase 10 telemetry. make up generates a unique admin password if left empty.
METRICS_SCRAPE_TIMEOUT_SECONDS=5
METRICS_STUCK_RUNNING_SECONDS=300
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=8003
OBSERVABILITY_PROMETHEUS_PORT=9090
OBSERVABILITY_GRAFANA_PORT=3001
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
GRAFANA_IMAGE=grafana/grafana:13.3.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
