{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ErrorRecord": {
      "additionalProperties": false,
      "description": "One failed execution, embedded in a dead letter's JSON error history.",
      "properties": {
        "attempt_no": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Attempt No",
          "type": "integer"
        },
        "generation": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "worker_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Worker Id",
          "type": "string"
        },
        "error": {
          "minLength": 1,
          "title": "Error",
          "type": "string"
        },
        "stack_trace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stack Trace"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "attempt_no",
        "worker_id",
        "error"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Canonical producer format; raw DLQ audit ingestion remains tolerant of external records.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "kind": {
      "const": "task.dead_letter",
      "default": "task.dead_letter",
      "title": "Kind",
      "type": "string"
    },
    "generation": {
      "default": 0,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "worker_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "fatal",
        "exhausted",
        "poison"
      ],
      "title": "Category",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "type": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$",
      "title": "Type",
      "type": "string"
    },
    "attempt_no": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Attempt No",
      "type": "integer"
    },
    "status": {
      "const": "DEAD_LETTERED",
      "default": "DEAD_LETTERED",
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "error_history": {
      "items": {
        "$ref": "#/$defs/ErrorRecord"
      },
      "title": "Error History",
      "type": "array"
    },
    "ai_diagnosis": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ai Diagnosis"
    },
    "resolution": {
      "anyOf": [
        {
          "enum": [
            "REQUEUED",
            "ESCALATED",
            "CANCELLED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resolution"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "category",
    "id",
    "task_id",
    "type",
    "attempt_no",
    "reason",
    "error_history",
    "ai_diagnosis",
    "resolution",
    "created_at"
  ],
  "title": "DeadLetterMessage",
  "type": "object"
}
